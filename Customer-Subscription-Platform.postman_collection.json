{
	"info": {
		"_postman_id": "c8a9f4e2-9b21-4f10-9831-2856f1a8c9b2",
		"name": "Customer Subscription Platform API Collection",
		"description": "Complete Postman API Collection for Customer Subscription & Service Usage Management Platform MCA Final Project.\nIncludes Auth, Customer Management, Plans, Features, Subscriptions, Usage Validation Engine, Upgrade/Downgrade, Cancellations, Renewals, Analytics, and Audit Logs.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080/api",
			"type": "string"
		},
		{
			"key": "admin_token",
			"value": "",
			"type": "string"
		},
		{
			"key": "customer_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Admin Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('admin_token', jsonData.token);",
									"    pm.collectionVariables.set('token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Customer Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.token) {",
									"    pm.collectionVariables.set('customer_token', jsonData.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"customer1\",\n  \"password\": \"customer123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					}
				},
				{
					"name": "Customer Register",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"newuser\",\n  \"password\": \"password123\",\n  \"email\": \"newuser@example.com\",\n  \"firstName\": \"New\",\n  \"lastName\": \"Customer\",\n  \"phone\": \"+91 9999888777\",\n  \"address\": \"High Street, Bangalore\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "register"]
						}
					}
				}
			]
		},
		{
			"name": "2. Customer Management",
			"item": [
				{
					"name": "Get All Customers (Admin)",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{admin_token}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/customers",
							"host": ["{{baseUrl}}"],
							"path": ["customers"]
						}
					}
				},
				{
					"name": "Get My Customer Profile",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{customer_token}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/customers/me",
							"host": ["{{baseUrl}}"],
							"path": ["customers", "me"]
						}
					}
				}
			]
		},
		{
			"name": "3. Subscription Plans",
			"item": [
				{
					"name": "Get Active Plans",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/plans/active",
							"host": ["{{baseUrl}}"],
							"path": ["plans", "active"]
						}
					}
				},
				{
					"name": "Create Subscription Plan (Admin)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{admin_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"planCode\": \"PLAN-ULTRA\",\n  \"planName\": \"Ultra Plan\",\n  \"description\": \"Unlimited high throughput plan\",\n  \"price\": 2999.00,\n  \"billingCycle\": \"MONTHLY\",\n  \"validityDays\": 30,\n  \"status\": \"ACTIVE\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/plans",
							"host": ["{{baseUrl}}"],
							"path": ["plans"]
						}
					}
				}
			]
		},
		{
			"name": "4. Service Features",
			"item": [
				{
					"name": "Get All Features",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{baseUrl}}/features",
							"host": ["{{baseUrl}}"],
							"path": ["features"]
						}
					}
				}
			]
		},
		{
			"name": "5. Usage Validation Engine",
			"item": [
				{
					"name": "Validate Usage - APPROVAL CASE",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{customer_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerId\": 1,\n  \"featureId\": 1,\n  \"requestedQuantity\": 20\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/usage/validate",
							"host": ["{{baseUrl}}"],
							"path": ["usage", "validate"]
						}
					}
				},
				{
					"name": "Validate Usage - REJECTION CASE (EXCEEDED LIMIT)",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Content-Type", "value": "application/json" },
							{ "key": "Authorization", "value": "Bearer {{customer_token}}" }
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"customerId\": 1,\n  \"featureId\": 1,\n  \"requestedQuantity\": 500\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/usage/validate",
							"host": ["{{baseUrl}}"],
							"path": ["usage", "validate"]
						}
					}
				},
				{
					"name": "Get Customer Usage Summary Gauges",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{customer_token}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/usage/my-summary",
							"host": ["{{baseUrl}}"],
							"path": ["usage", "my-summary"]
						}
					}
				}
			]
		},
		{
			"name": "6. Upgrade & Downgrade",
			"item": [
				{
					"name": "Request Plan Upgrade",
					"request": {
						"method": "POST",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{customer_token}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/upgrade-downgrade/request?subscriptionId=1&requestedPlanId=2&reason=Need%20higher%20quota",
							"host": ["{{baseUrl}}"],
							"path": ["upgrade-downgrade", "request"],
							"query": [
								{ "key": "subscriptionId", "value": "1" },
								{ "key": "requestedPlanId", "value": "2" },
								{ "key": "reason", "value": "Need higher quota" }
							]
						}
					}
				}
			]
		},
		{
			"name": "7. Analytics & Audit Logs",
			"item": [
				{
					"name": "Get Admin Dashboard Analytics",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{admin_token}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/analytics/dashboard",
							"host": ["{{baseUrl}}"],
							"path": ["analytics", "dashboard"]
						}
					}
				},
				{
					"name": "Get Audit Logs",
					"request": {
						"method": "GET",
						"header": [
							{ "key": "Authorization", "value": "Bearer {{admin_token}}" }
						],
						"url": {
							"raw": "{{baseUrl}}/audit-logs",
							"host": ["{{baseUrl}}"],
							"path": ["audit-logs"]
						}
					}
				}
			]
		}
	]
}
